<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: the build must not depend on (or wait for) feeds configured on a developer's machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
