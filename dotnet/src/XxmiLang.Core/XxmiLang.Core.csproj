<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../AotLibrary.props" />

  <PropertyGroup>
    <RootNamespace>XxmiLang</RootNamespace>
    <AssemblyName>XxmiLang.Core</AssemblyName>
    <Description>Shared models and interfaces of the xxmi-lang .NET library for XXMI / 3DMigoto mod .ini files: diagnostics, locations, edits, IXxmiLinter and IXxmiLanguageService, and a source-generated System.Text.Json context. No I/O; trim and Native AOT safe. XxmiLang implements the interfaces.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="XxmiLang.Core.Tests" />
  </ItemGroup>

</Project>
