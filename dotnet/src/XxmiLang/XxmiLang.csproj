<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../AotLibrary.props" />

  <PropertyGroup>
    <RootNamespace>XxmiLang</RootNamespace>
    <AssemblyName>XxmiLang</AssemblyName>
    <Description>Linter and language service client for XXMI / 3DMigoto mod .ini files (ZZMI, GIMI, SRMI, WWMI, HIMI). Drives the bundled xxmi tool (lint, hover, definition, references, completion, rename, quick fixes). Add an XxmiLang.Native.&lt;rid&gt; package for the binary. Trim and Native AOT compatible.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs on internals are fine; public API is documented. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XxmiLang.Core/XxmiLang.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="XxmiLang.Tests" />
  </ItemGroup>

</Project>
