<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>XxmiLang.All</id>
    <version>$version$</version>
    <authors>xxmi-lang contributors</authors>
    <description>XxmiLang plus the xxmi binary for Windows, Linux and macOS (x64 and arm64). One package reference for an app that runs anywhere.</description>
    <license type="expression">GPL-3.0-or-later</license>
    <projectUrl>https://github.com/xxmi-lang/xxmi-lang</projectUrl>
    <repository type="git" url="https://github.com/xxmi-lang/xxmi-lang" />
    <readme>README.md</readme>
    <tags>xxmi 3dmigoto ini linter lsp zzz modding</tags>
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="XxmiLang" version="$version$" />
        <dependency id="XxmiLang.Native.win-x64" version="$version$" />
        <dependency id="XxmiLang.Native.win-arm64" version="$version$" />
        <dependency id="XxmiLang.Native.linux-x64" version="$version$" />
        <dependency id="XxmiLang.Native.linux-arm64" version="$version$" />
        <dependency id="XxmiLang.Native.osx-x64" version="$version$" />
        <dependency id="XxmiLang.Native.osx-arm64" version="$version$" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="$readme$" target="README.md" />
    <file src="_._" target="lib/netstandard2.0/_._" />
  </files>
</package>
