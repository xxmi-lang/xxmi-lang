{
  "name": "@xxmi-lang/spec-extractor",
  "version": "0.0.0",
  "private": true,
  "description": "Reads the XXMI DLL C++ source and writes spec/generated/*.json",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xxmi-lang/core": "workspace:*"
  }
}
