# Hosted MCP server, Rust build (docs/06-mcp-server.md). Build context is the repository root:
#   docker build -f packages/mcp-server/Dockerfile.rust -t xxmi-mcp-rs .
# Railway keeps using Dockerfile (TypeScript) until the switch.

# The embedded spec is generated by the TypeScript build (packages/core/dist/spec.json).
FROM node:22-alpine AS spec
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter "@xxmi-lang/core..." \
 && pnpm --filter "@xxmi-lang/core..." build

# Keep the tag equal to rust/rust-toolchain.toml; the C compiler in this image builds tree-sitter.
FROM rust:1.100-slim-trixie AS build
WORKDIR /repo
COPY . .
COPY --from=spec /repo/packages/core/dist/ packages/core/dist/
RUN cd rust && cargo build --release --locked -p xxmi-mcp

FROM debian:trixie-slim
# ripgrep backs search_source; git fetches the tracked repos; gosu drops root after fixing the
# volume's ownership; curl serves the health check.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git gosu ripgrep \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 1000 node && useradd -u 1000 -g node -m -s /bin/sh node \
 && ln -s /usr/sbin/gosu /usr/local/bin/su-exec
COPY --from=build /repo/rust/target/release/xxmi-mcp /usr/local/bin/xxmi-mcp
# The entrypoint is shared with the TypeScript image; it calls su-exec, which gosu stands in for.
COPY packages/mcp-server/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
ENV DATA_DIR=/data \
    PORT=3000 \
    TRUSTED_PROXY_HOPS=1
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD curl -fsS "http://127.0.0.1:${PORT}/healthz" >/dev/null || exit 1
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["xxmi-mcp"]
