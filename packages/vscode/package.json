{
  "name": "xxmi-lang",
  "displayName": "XXMI Language Tools",
  "description": "Diagnostics, go to definition, references, rename, hover and completion for XXMI / 3DMigoto mod .ini files. Highlighting comes from lupomikti's 3DMigoto INI extension.",
  "version": "0.1.0",
  "publisher": "xxmi-lang",
  "license": "GPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/xxmi-lang/xxmi-lang"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "3dmigoto",
    "xxmi",
    "zzmi",
    "gimi",
    "ini"
  ],
  "activationEvents": [
    "onLanguage:migoto"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "migoto",
        "aliases": [
          "Migoto",
          "3dm-ini",
          "3dmigoto"
        ],
        "extensions": [
          ".ini",
          ".3dm",
          ".migoto"
        ]
      }
    ],
    "configuration": {
      "title": "XXMI",
      "properties": {
        "xxmi.rules": {
          "type": "object",
          "default": {},
          "markdownDescription": "Rule severities, e.g. `{ \"XM204\": \"off\", \"XM102\": \"error\" }`. Values: `off`, `error`, `warning`, `info`, `hint`. Overrides `xxmi.toml`.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "off",
              "error",
              "warning",
              "info",
              "hint"
            ]
          }
        },
        "xxmi.lsp.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to an `xxmi-lsp` executable to use instead of the bundled server."
        }
      }
    },
    "commands": [
      {
        "command": "xxmi.restartServer",
        "title": "XXMI: Restart server"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/bundle.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node scripts/bundle.ts && vsce package --no-dependencies --skip-license --out dist/xxmi-lang.vsix",
    "test:vscode": "node test/run.ts"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "@xxmi-lang/core": "workspace:*",
    "@xxmi-lang/lsp": "workspace:*",
    "esbuild": "^0.28.2",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2"
  },
  "type": "module"
}
