{
  "name": "@xxmi-lang/lsp",
  "version": "0.0.0",
  "description": "xxmi-lsp: language server for XXMI / 3DMigoto mod .ini files",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "xxmi-lsp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --conditions=source src/main.ts --stdio"
  },
  "dependencies": {
    "@xxmi-lang/core": "workspace:*",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "vscode-languageserver-protocol": "^3.18.4"
  }
}
