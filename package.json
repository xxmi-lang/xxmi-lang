{
  "name": "xxmi-lang-workspace",
  "private": true,
  "description": "Language tooling for 3DMigoto / XXMI mod .ini files",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:corpus": "node scripts/test-corpus.ts",
    "test:lsp": "vitest run --root tests/lsp-protocol",
    "check:version": "node scripts/check-version.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck && tsc -p scripts --noEmit && tsc -p tests/lsp-protocol --noEmit",
    "grammar:update": "node scripts/update-grammar.ts",
    "spec:extract": "cargo run --release -q --manifest-path rust/Cargo.toml -p xxmi-spec-extractor --",
    "xxmi": "cargo run --release -q --manifest-path rust/Cargo.toml -p xxmi --",
    "build:binaries": "node scripts/build-binaries.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "vscode-languageserver-protocol": "^3.18.4"
  }
}
