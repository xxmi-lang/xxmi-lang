{
  "name": "xxmi-lang",
  "private": true,
  "description": "Language tooling for 3DMigoto / XXMI mod .ini files",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:corpus": "node scripts/test-corpus.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck && tsc -p scripts --noEmit",
    "grammar:update": "node scripts/update-grammar.ts",
    "spec:extract": "node packages/spec-extractor/src/cli.ts",
    "xxmi": "node --conditions=source packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
