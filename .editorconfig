root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Fixtures reproduce real mod files byte for byte (tabs, CRLF, BOMs).
[fixtures/**]
charset = unset
end_of_line = unset
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
